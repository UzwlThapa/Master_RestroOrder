<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  Root web.config for SageFrame RestroOrder
  Updated to 2026 security standards with HTTPS enforcement
-->
<configuration>
    <system.webServer>
        <!-- Disable directory browsing for security -->
        <directoryBrowse enabled="false" />
        <!-- Security headers at root level -->
        <httpProtocol>
            <customHeaders>
                <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains; preload" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="DENY" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
    <connectionStrings>
        <remove name="OraAspNetConString" />
        <remove name="LocalSqlServer" />
        <remove name="LocalMySqlServer" />
        <!-- 
          IMPORTANT: Update connection string for production
          - Use SQL Authentication or Windows Authentication as appropriate
          - Consider using encrypted connection strings
          - Enable SSL/TLS for database connections
        -->
        <add connectionString="Data Source=DESKTOP-9VVHFMK;Initial Catalog=30GrillDurbarDB;Integrated Security=False;Persist Security Info=False;User ID=sa;Password=saa;Connect Timeout=120;Encrypt=True;TrustServerCertificate=False" name="SageFrameConnectionString" />
    </connectionStrings>
</configuration>
