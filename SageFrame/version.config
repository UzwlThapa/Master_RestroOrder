<?xml version="1.0" encoding="UTF-8"?>
<appSettings>
	<clear />

	<!-- ==================== Editor / Upload ==================== -->
	<add key="FCKeditor:BasePath" value="~/Editors/fckeditor/" />
	<add key="CKeditor:BasePath" value="~/Editors/ckeditor" />
	<add key="FCKeditor:UserFilesPath" value="~/Upload/" />
	<add key="ChartImageHandler" value="storage=file;timeout=20;dir=C:\TempImageFiles;" />

	<!-- ==================== Database ==================== -->
	<add key="DatabaseName" value="" />
	<add key="objectQualifier" value="" />
	<add key="databaseOwner" value="dbo" />
	<add key="databaseVersion" value="02.00.00" />

	<!-- ==================== SageFrame Core ==================== -->
	<add key="IsInstalled" value="true" />
	<add key="InstallationDate" value="8/20/2015" />
	<add key="SageFrameVersion" value="3.6" />
	<add key="ShowException" value="false" />

	<!-- ==================== RestroOrder Settings ==================== -->
	<add key="SplitCostCenterInBill" value="false" />
	<add key="ServChargeInTakeAway" value="false" />
	<add key="VATforBill" value="true" />
	<add key="ItemCharacterLimit" value="100" />
	<add key="CompanyCode" value="RO-DELI-005" />

	<add key="FoodCourtOrderPrinting" value="true" />
	<add key="WholeSaleOrderPrinting" value="true" />
	<add key="FoodCourtEstimateOrders" value="true" />
	<add key="foodCourtAutoBillGenerate" value="false" />
	<add key="OrderPrinting" value="true" />
	<add key="costcenterRefreshInterval" value="1" />

	<add key="KOTCharacterLength" value="34" />
	<add key="KOTFontSize" value="10" />
	<add key="KOTPRINTCOUNT" value="1" />

	<add key="Notification" value="true" />
	<add key="CbmsApiBaseUrl" value="http://202.166.207.75:9050/" />
	<add key="TimeToSyncBillsInMinutes" value="120" />

	<!-- ==================== Mail (SMTP not actually used – see SendMail) ==================== -->
	<add key="SMTPHost" value=" " />
	<!-- not used -->
	<add key="SMTPPort" value=" " />
	<!-- not used -->
	<add key="MailFrom" value=" " />
	<!-- not used -->
	<add key="MailTo" value="ujjwal@restroorder.com" />
	<add key="MailCC" value="ujjwalt707@gmail.com" />

	<!-- ==================== SMS ==================== -->
	<add key="Authentication_Token" value="" />
	<add key="SMS_APIUrl" value="https://sms.aakashsms.com/sms/v3/send" />
	<add key="FromNumber" value="AT_Alert" />
	<add key="SMSVendor" value="SMSService" />

	<!-- ==================== Order / Menu ==================== -->
	<add key="OrderMenuListType" value="true" />
	<add key="OrderMenuImageshow" value="true" />
	<add key="PaymentAfterGenerateBill" value="true" />
	<add key="NumPinPad" value="false" />
	<add key="OccupiedTableDayClosedEnable" value="false" />
	<add key="AddItemInMenuSearch" value="false" />
	<add key="QRCode" value="false" />

	<!-- ==================== Printer ==================== -->
	<add key="DBPrinting" value="true" />
	<add key="PrintOrderShiftBill" value="false" />

	<!-- ==================== Stock ==================== -->
	<add key="IsAutoPurchase" value="false" />

	<!-- ==================== Bill ==================== -->
	<add key="ShowTotalDiscount" value="false" />

	<!-- ==================== Close day warning mail ==================== -->
	<add key="EnableCloseDayWarning" value="true" />
	<add key="DayOpeningTime" value="08:00" />
	<add key="DayClosingTime" value="10:00" />

	<!-- ==================== Close day fixed float ==================== -->
	<!-- Client requires a fixed 3000 petty cash float carried into every day's opening balance.
	     Set to 0 to disable and revert to dynamic opening balance (= prior day's closing balance). -->
	<add key="DayCloseFixedFloat" value="3000" />

	<!-- ==================== Vendor cash payment handling ==================== -->
	<!-- true  = vendor cash payments reduce CashInCounter (paid from drawer)  -->
	<!-- false = vendor cash payments do not affect drawer (paid from outside)  -->
	<add key="UseCounterCashForVendor" value="false" />
</appSettings>