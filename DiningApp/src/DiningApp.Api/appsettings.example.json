// Copy to appsettings.json on the SERVER and fill in real values. NEVER commit appsettings.json:
// it contains the SQL credentials. On a shared/locked-down POS box you can instead set the
// DINING_CONNECTIONSTRING environment variable (machine scope) — it wins over this file.
{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    // Legacy web.config <appSettings> keys, copied from the old SageFrame web.config of THIS site:
    // OrderMenuListType/OrderMenuImageshow drive the waiter menu UI; OrderPrinting/DBPrinting gate KOT printing.
    "OrderMenuListType": "1",
    "OrderMenuImageshow": "1",
    "OrderPrinting": "1",
    "DBPrinting": "1"
  },
  "ConnectionStrings": {
    // Windows-auth example (recommended on-prem when the service runs as a domain service account):
    //   "Data Source=.\\SQLEXPRESS;Initial Catalog=RestroOrder;Integrated Security=True;TrustServerCertificate=True"
    // SQL-auth example:
    //   "Data Source=192.168.1.10\\SQLEXPRESS;Initial Catalog=RestroOrder;User ID=restro;Password=CHANGE_ME;TrustServerCertificate=True"
    "LocalSqlServer": "Data Source=.\\SQLEXPRESS;Initial Catalog=RestroOrder;Integrated Security=True;TrustServerCertificate=True"
  },
  "Dining": {
    // HTTP port waiter tablets reach; open this port in install.cmd's firewall rule
    "Port": 8007,
    // UDP port the old WPF waiter client listens on for new-order bells
    "UdpNotifyPort": 51100
  }
}
