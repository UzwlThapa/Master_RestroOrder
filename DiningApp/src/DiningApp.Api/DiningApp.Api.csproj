<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DiningApp.Api</AssemblyName>
    <RootNamespace>DiningApp.Api</RootNamespace>
    <!-- Windows-targeted analyzer noise off for cross-platform CI builds -->
    <NoWarn>CA1416;CS0618;NU1701</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiningApp.Legacy\DiningApp.Legacy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows service hosting for on-prem servers (Win10/11/Server): sc.exe / Service Control Manager -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>
</Project>
